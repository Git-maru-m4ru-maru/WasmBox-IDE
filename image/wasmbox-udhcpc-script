#!/bin/sh
# busybox の udhcpc が呼ぶスクリプト。環境変数 interface / ip / mask / router / dns / domain が渡される。
# resolv.conf は /run（tmpfs）に書く（/etc/resolv.conf はそこへのシンボリックリンク。毎回ディスクに書かないため）。
# WASMBOX_RESOLV_CONF は、テストで差し替えるためのもの。
RESOLV_CONF=${WASMBOX_RESOLV_CONF:-/run/resolv.conf}

echo "udhcpc: $1 interface=$interface ip=$ip mask=$mask subnet=$subnet router=$router dns=$dns domain=$domain"

case "$1" in
  deconfig)
    ip addr flush dev "$interface"
    ip link set "$interface" up
    ;;
  bound | renew)
    ip addr flush dev "$interface"
    ip addr add "$ip/${mask:-24}" brd + dev "$interface"
    for gateway in $router; do
      ip route add default via "$gateway" dev "$interface" && break
    done
    {
      [ -n "$domain" ] && echo "search $domain"
      for server in $dns; do echo "nameserver $server"; done
    } >"$RESOLV_CONF"
    ;;
esac
exit 0
