{
  "name": "wasmbox",
  "version": "0.0.1",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "description": "ブラウザ内で動くWASM仮想Linux環境",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "chunk-image": "node tools/chunk-image.ts",
    "poc:build": "esbuild poc/main.ts poc/selftest.ts poc/alpine.ts --bundle --format=esm --target=es2022 --outdir=poc/dist",
    "poc:serve": "node tools/serve.ts poc 8080",
    "poc": "npm run poc:build && npm run poc:serve",
    "site:build": "node tools/build-site.ts && esbuild app/main.ts --bundle --format=esm --target=es2022 --outfile=site/app.js",
    "site:serve": "node tools/serve.ts site 8080",
    "relay": "node tools/relay.mjs",
    "relay:check": "node tools/relay-check.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.27.0",
    "fake-indexeddb": "^6.0.0",
    "typescript": "^6.0.0"
  }
}
